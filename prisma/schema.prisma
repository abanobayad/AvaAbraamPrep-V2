generator client {
  provider      = "prisma-client-js"
  // "native" covers the build machine; the others cover Hostinger's Linux runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Khadem {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      String   // 'superadmin' | 'admin'
  createdAt DateTime @default(now())
}

model Student {
  id           String        @id @default(cuid())
  name         String
  studentCode  String?       @unique
  studentClass String
  phone        String?
  address      String?       @db.Text
  notes        String?       @db.Text
  totalPoints  Int           @default(0)
  needsEfteqad Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  attendances  Attendance[]
  efteqadLogs  EfteqadLog[]
}

model Transaction {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  actionName    String
  pointsChanged Int
  addedBy       String
  timestamp     DateTime @default(now())

  @@index([studentId])
}

model Media {
  id        String   @id @default(cuid())
  title     String
  url       String   @db.Text
  type      String   // 'video', 'document', 'image', 'link'
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  date       DateTime
  status     Boolean  // true = present, false = absent
  recordedBy String
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model EfteqadLog {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  date       DateTime @default(now())
  khademName String
  notes      String?  @db.Text

  @@index([studentId])
}

model LoginAttempt {
  key         String    @id
  count       Int       @default(1)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}
