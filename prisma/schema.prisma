generator client {
  provider      = "prisma-client-js"
  // "native" covers the build machine; the others cover Hostinger's Linux runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Khadem {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      String   // 'superadmin' | 'admin'
  createdAt DateTime @default(now())
}

model Student {
  id           String        @id @default(cuid())
  name         String
  studentCode  String?       @unique
  studentClass String
  phone        String?
  address      String?       @db.Text
  notes        String?       @db.Text
  totalPoints  Int           @default(0)
  needsEfteqad Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  attendances  Attendance[]
  efteqadLogs  EfteqadLog[]
  meetingAttendances MeetingAttendance[]
}

model Transaction {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  actionName    String
  pointsChanged Int
  addedBy       String
  timestamp     DateTime @default(now())

  @@index([studentId])
}

model Media {
  id        String   @id @default(cuid())
  title     String
  url       String   @db.Text
  type      String   // 'video', 'document', 'image', 'link'
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  date       DateTime
  status     Boolean  // true = present, false = absent
  recordedBy String
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model EfteqadLog {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  date       DateTime @default(now())
  khademName String
  notes      String?  @db.Text

  @@index([studentId])
}

model LoginAttempt {
  key         String    @id
  count       Int       @default(1)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

/// A recurring meeting or activity (mass, Sunday school, hymns...). Weekly: one day and
/// time. Daily: a per-day schedule (JSON text). Each date it is held gets a MeetingSession.
model Meeting {
  id           String           @id @default(cuid())
  title        String
  category     String           // key from src/config/meetings.ts
  points       Int              // points each present student earns per session (0 = none)
  frequency    String           @default("weekly") // 'weekly' | 'daily'
  day          String?          // weekly: English weekday name (Saturday..Friday); daily: first held day
  startTime    String?          // "HH:MM"
  endTime      String?          // "HH:MM", optional
  schedule     String?          @db.Text // daily: {"Sunday":{"begin":"07:00","end":"09:00"},...}
  studentClass String?          // null = all classes
  notes        String?          @db.Text
  createdBy    String
  createdAt    DateTime         @default(now())
  sessions     MeetingSession[]
}

/// One attendance sheet of a meeting on a given date.
model MeetingSession {
  id          String              @id @default(cuid())
  meetingId   String
  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  date        DateTime            @db.Date
  createdBy   String
  createdAt   DateTime            @default(now())
  attendances MeetingAttendance[]

  @@unique([meetingId, date])
  @@index([date])
}

/// One student marked present on a session; transactionId links the points it awarded.
model MeetingAttendance {
  id            String         @id @default(cuid())
  sessionId     String
  session       MeetingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactionId String?        @unique
  recordedBy    String
  createdAt     DateTime       @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}
